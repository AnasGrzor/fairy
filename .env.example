# Copy to .env.local for local development, and add the same keys in Vercel (Project > Settings > Environment Variables).

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Who may sign in to /admin (comma separated). Create these users in Supabase > Authentication > Users.
ADMIN_EMAILS=sami@example.com

# Optional: email Sami when a request comes in (https://resend.com). Leave blank to skip.
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=fairymeadowscomfortlodges@gmail.com
# A sender on a domain verified in Resend. Without one, Resend only delivers to your own Resend account email.
BOOKING_FROM_EMAIL=

# Used in link previews and in the admin link inside alert emails.
NEXT_PUBLIC_SITE_URL=https://fairymeadowscomfortlodges.com
